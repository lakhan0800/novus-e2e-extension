{
  "manifest_version": 3,
  "name": "Tabkeeper",
  "version": "1.0.0",
  "description": "Save and restore groups of browser tabs. Setup scenario fixture for Novus (PX-274).",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabkeeper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
